<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />
    <!-- P-103 — Referencia explícita solo para alinear versiones. `Terrenario.Api` compila contra
         Relational 9.0.18 (se lo sube `Microsoft.EntityFrameworkCore.Design`, que no propaga por ser
         `PrivateAssets=all`), pero aquí la única que llegaba era la 9.0.1 que pide Npgsql, y ganaba
         por ser la principal (`MSB3277`): la suite se ejecutaba contra una Relational más antigua
         que la del runtime, así que un fallo dependiente de versión podía no verse en los tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <!-- Reloj controlable (MVP-601): medir duraciones de login y cadencias de volcado sin esperarlas. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.*" />
    <!-- PostgreSQL real en contenedor (MVP-501): los tests de repositorio y el arnés de API
         ejercitan el MISMO motor que producción. Antes se usaba SQLite, y eso obligaba a degradar
         consultas de producción para que el arnés pudiera ejecutarlas (P-031). Requiere Docker. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="5.3.*" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Permite testear componentes web (filtros MVC, controllers) contra tipos de ASP.NET Core. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Terrenario.Api\Terrenario.Api.csproj" />
  </ItemGroup>

  <!-- MVP-603 — El `appsettings.json` que se publica entra en la salida del test para poder afirmar
       sobre los valores **que viajan al despliegue**, no sobre los que tiene la clase en memoria. Lo
       estrena la guarda de `Ops:ApiKey`: el defecto estaba en el fichero, no en el código. -->
  <ItemGroup>
    <Content Include="..\Terrenario.Api\appsettings.json" Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
