{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=terrenario;Username=terrenario;Password=REPLACE_IN_SECRETS"
  },
  "Auth": {
    "Google": {
      "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
      "ClientSecret": "REPLACE_IN_SECRETS"
    },
    "Jwt": {
      "Issuer": "terrenario-api",
      "Audience": "terrenario-web",
      "AccessTokenLifetimeSeconds": 900,
      "PrivateKeyPem": "REPLACE_IN_SECRETS",
      "PublicKeyPem": "REPLACE_IN_SECRETS"
    },
    "RefreshToken": {
      "LifetimeSeconds": 2592000
    }
  },
  "Invitations": {
    "LifetimeDays": 7,
    "AcceptBaseUrl": "https://app.terrenario.com/invitations"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "SecurityMode": "starttls",
    "Username": "",
    "FromAddress": "",
    "FromName": "Terrenario",
    "TimeoutSeconds": 15
  },
  "WorkspaceLifecycle": {
    "ReactivationLifetimeDays": 7,
    "ReactivationBaseUrl": "https://app.terrenario.com/reactivations"
  },
  "Retention": {
    "Enabled": true,
    "IntervalHours": 24,
    "InitialDelayMinutes": 5
  },
  "Telemetry": {
    "Enabled": true,
    "FlushIntervalSeconds": 60,
    "RetentionDays": 400
  },
  "Legal": {
    "PrivacyPolicyUrl": "https://app.terrenario.com/legal/privacidad"
  },
  "Ops": {
    "AlertsEnabled": true,
    "AlertEmail": "",
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": ["https://app.terrenario.com"]
  }
}
