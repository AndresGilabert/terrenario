# URL base del backend API
# Puerto del perfil "http" en src/backend/Terrenario.Api/Properties/launchSettings.json
VITE_API_BASE_URL=http://localhost:5127

# Google OAuth 2.0 Client ID (obtener en Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
# Debe coincidir con el valor de Auth:Google:ClientId configurado en el backend
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Identidad legal (MVP-504, B-1) -----------------------------------------
# OPCIONALES. Los valores por defecto están versionados en src/config/legal-entity.ts, porque la
# LSSI obliga a publicarlos y este fichero no llega al despliegue. Define estas variables solo si
# un entorno concreto necesita datos distintos; una variable vacía se ignora y cae al valor por
# defecto, para que un despliegue mal configurado no publique un hueco en un documento legal.
# VITE_LEGAL_NAME=Razón social
# VITE_LEGAL_TAX_ID=00000000X
# VITE_LEGAL_ADDRESS=Calle, número, CP Municipio (Provincia), País
# VITE_LEGAL_PRIVACY_EMAIL=privacidad@ejemplo.test
# VITE_LEGAL_DPO=No designado
# VITE_LEGAL_EMAIL_PROVIDER=Proveedor de correo
# VITE_LEGAL_HOSTING_PROVIDER=Proveedor de alojamiento
# VITE_LEGAL_HOSTING_REGION=España
